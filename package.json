{
  "name": "mycatalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --quiet",
    "lint:report": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test tests/critical-flow.spec.ts --project=chromium",
    "test:e2e:signup": "playwright test tests/signup.spec.ts --project=signup",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:db": "node scripts/db-check.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:drift": "node scripts/db-drift.mjs",
    "db:rebuild-check": "node scripts/db-rebuild-check.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "better-auth": "1.7.18",
    "zod": "4.6.7"
  }
}
