# ==========================================
# BANCO DE DADOS (Neon PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# AUTENTICACAO (Neon Auth)
# ==========================================
NEON_AUTH_BASE_URL=https://auth.neon.tech
NEON_AUTH_COOKIE_SECRET=your-64-character-hex-secret-here-minimum-32-chars

# ==========================================
# STORAGE DE AVATARES (Vercel Blob)
# ==========================================
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ==========================================
# TMDB (The Movie Database)
# ==========================================
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ==========================================
# IA (Google Gemini)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ==========================================
# INDEXADOR UNIVERSAL V4
# ==========================================
V4_MOVIE_PAGES=1
V4_TV_PAGES=1
V4_CONCURRENCY=4

# ==========================================
# CONFIGURACAO DA APLICACAO
# ==========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# PLAYWRIGHT (Testes E2E)
# ==========================================
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SIGNUP_DOMAIN=
