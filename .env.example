# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use a chave pública adequada ao seu projeto.
# Mantenha ambas somente enquanto houver compatibilidade com
# ambientes Supabase antigos e novos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exclusivamente servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Exclusivamente servidor
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR

# URLs públicas, sem credenciais
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Exclusivamente servidor
GEMINI_API_KEY=
GEMINI_MODEL=

# Configuração do script de indexação
V4_MOVIE_PAGES=1
V4_TV_PAGES=1
V4_CONCURRENCY=4

# URL pública de produção, usada por metadata e robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SIGNUP_DOMAIN=